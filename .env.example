# Copy to .env (git-ignored) and fill in. Real environment variables take precedence over .env.

# How questions are interpreted:
#   openai_compatible = an LLM behind an OpenAI-compatible /chat/completions endpoint with tool calling
#   stub              = keyword rules, no LLM (clearly labelled in every response; for running without a key)
LLM_PROVIDER=openai_compatible

# Endpoint, key and model. Tested: OpenRouter (see README). Other OpenAI-compatible endpoints are untested.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-haiku-5.5
LLM_TIMEOUT_SECONDS=30

# Frontend origin allowed to call the API
CORS_ORIGINS=http://localhost:5173
